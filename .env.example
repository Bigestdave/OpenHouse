# ============================================================================
# OpenHouse Environment Configuration
# ============================================================================

# Supabase Project Credentials
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional API base URL (if running external backend)
VITE_API_BASE_URL=http://localhost:8000/api

# Server-side Gemini key for /api/gemini endpoint
GEMINI_API_KEY=your-gemini-server-key-here
